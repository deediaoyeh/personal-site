# 複製此檔案並重新命名為 .sync.env（已在 .gitignore 排除，不會上傳私密網址）

# 1. Google Apps Script 部署後的網頁應用程式網址（供本機拉取 Google Drive 內容）
GOOGLE_WORKSPACE_FEED_URL=""
GOOGLE_WORKSPACE_SYNC_TOKEN=""

# 2. 若你的 Mac 有安裝 Google Drive 桌面版，可填入雲端硬碟對應資料夾路徑，雙擊 sync.command 即雙向備份
# 範例：GOOGLE_DRIVE_LOCAL_DIR="/Users/deediao/Library/CloudStorage/GoogleDrive-你的信箱/我的雲端硬碟/WebsiteContent"
GOOGLE_DRIVE_LOCAL_DIR=""

# 3. Netlify 備份站的 Build Hook 網址（選填，綁定 GitHub 後 push 就會自動更新，填此項可強制額外觸發）
NETLIFY_BUILD_HOOK_URL=""

# 4. 網站正式主站網址（產生 RSS 連結用）
SITE_BASE_URL="https://example.github.io"
